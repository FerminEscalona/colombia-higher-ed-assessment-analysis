# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs and OS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Data artifacts (exclude contents, preserve structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts (exclude binaries/checkpoints, preserve structure via .gitkeep)
models/*
!models/.gitkeep

# Figures used in reports are versioned so they can be reused in written deliverables.
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/*.png
!reports/figures/*.md
